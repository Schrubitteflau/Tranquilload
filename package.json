{
  "name": "tranquilload-monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "test:e2e": "pnpm --filter @tranquilload/tests test:e2e",
    "test:e2e:chromium": "pnpm --filter @tranquilload/tests test:e2e:chromium",
    "test:e2e:install": "pnpm --filter @tranquilload/tests test:e2e:install",
    "test-app:reset": "bash scripts/test-app-reset.sh",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "turbo": "^2.9.3",
    "typescript": "^5.5.0"
  }
}
