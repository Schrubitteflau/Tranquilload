# ---------------------------------------------------------------------------
# Tranquilload test harness — environment template
# Copy to .env (gitignored) and adjust as needed.
# ---------------------------------------------------------------------------

# Test environment label (informational; surfaced in HTML report)
TEST_ENV=local

# Base URL of the test-app frontend (Vite dev server)
BASE_URL=http://localhost:5173

# Test-app backend API (proxied through Vite; only set if you bypass the proxy)
API_URL=http://localhost:3000

# ---------- MinIO (verification side-channel for E2E tests) ----------
# These mirror examples/test-app/docker-compose.yml. Adjust ONLY if you run a
# different MinIO instance (e.g. shared CI bucket).
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tranquilload-test
MINIO_REGION=us-east-1

# ---------- Playwright runtime ----------
# Set to skip the auto-started webServer (e.g. when you've already started the
# test-app in another terminal). Useful for `playwright test --debug`.
# SKIP_WEBSERVER=1
