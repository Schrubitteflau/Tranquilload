{
  "name": "@tranquilload/test-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "minio:up": "docker compose up -d",
    "minio:down": "docker compose down",
    "minio:logs": "docker compose logs -f minio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@tranquilload/adapters": "workspace:*",
    "@tranquilload/core": "workspace:*",
    "effect": "3.19.19",
    "fastify": "^5.2.0",
    "@fastify/cors": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "concurrently": "^9.0.0",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  }
}
