S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=tranquilload-test
SERVER_PORT=3000
# When the browser uploads via presigned URL, it talks to S3_PUBLIC_ENDPOINT
# (must be reachable from the browser — for local dev, same as S3_ENDPOINT)
S3_PUBLIC_ENDPOINT=http://localhost:9000
